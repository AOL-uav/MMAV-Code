FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application pimpleFoam;
startFrom latestTime;
startTime 0;
stopAt endTime;
endTime 30;
deltaT 1e-05;
writeControl adjustableRunTime;
writeInterval 5;
purgeWrite 2;
writeFormat binary;
writePrecision 8;
timeFormat general;
timePrecision 8;
runTimeModifiable false;
adjustTimeStep yes;
maxCo 1.5;
maxDeltaT 0.02;
functions
{
  forceCoeffs1
  {
    type forceCoeffs; libs (forces);
    writeControl timeStep; writeInterval 1;
    patches (plate);
    rho rhoInf; rhoInf 1;
    liftDir (0 0 1); dragDir (1 0 0);
    CofR (0.25 0 0); pitchAxis (0 1 0);
    magUInf 1; lRef 1; Aref 1.5;
  }
  yPlus1
  {
    type yPlus; libs (fieldFunctionObjects);
    writeControl writeTime; patches (plate);
  }
  probes1
  {
    type probes; libs (sampling);
    writeControl timeStep; writeInterval 20;
    fields (k nut);
    probeLocations ( (-9.5 0.75 0.5) (-0.3 0.75 0.5) );
  }
}
