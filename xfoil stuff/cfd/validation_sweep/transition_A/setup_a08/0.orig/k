FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object k;
}
dimensions [0 2 -2 0 0 0 0];
internalField uniform 1.5e-06;
boundaryField
{
  inlet  { type fixedValue; value uniform 1.5e-06; }
  outlet { type inletOutlet; inletValue uniform 1.5e-06; value uniform 1.5e-06; }
  bottom { type zeroGradient; }
  top    { type zeroGradient; }
  side   { type zeroGradient; }
  sym    { type symmetryPlane; }
  plate  { type fixedValue; value uniform 0; }
}
