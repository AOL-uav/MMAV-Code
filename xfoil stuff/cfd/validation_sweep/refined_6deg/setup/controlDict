FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         20;

deltaT          1e-05;

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

timeFormat      general;

timePrecision   8;

runTimeModifiable false;

adjustTimeStep  yes;

maxCo           1.5;

maxDeltaT       0.02;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            ( forces );
        writeControl    timeStep;
        writeInterval   1;
        patches         ( plate );
        rho             rhoInf;
        rhoInf          1;
        liftDir         ( 0 0 1 );
        dragDir         ( 1 0 0 );
        CofR            ( 0.25 0 0 );
        pitchAxis       ( 0 1 0 );
        magUInf         1;
        lRef            1;
        Aref            1.5;
    }
    yPlus1
    {
        type            yPlus;
        libs            ( fieldFunctionObjects );
        writeControl    writeTime;
        patches         ( plate );
    }
    wallShearStress1
    {
        type            wallShearStress;
        libs            ( fieldFunctionObjects );
        writeControl    writeTime;
        patches         ( plate );
    }
    fieldAverage1
    {
        type            fieldAverage;
        libs            ( fieldFunctionObjects );
        writeControl    writeTime;
        timeStart       8;
        fields          ( U { mean on ; prime2Mean off ; base time ; } p { mean on ; prime2Mean off ; base time ; } wallShearStress { mean on ; prime2Mean off ; base time ; } );
    }
}


